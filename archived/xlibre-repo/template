# Template file for 'xlibre-repo'
pkgname=xlibre-repo
version=25.1.9
revision=1
short_desc="XLibre for VOID linux"
maintainer="Sofiya <sofiya@v.com>"
license="MIT"
homepage="https://github.com/xlibre-void/xlibre/"
distfiles="https://raw.githubusercontent.com/xlibre-void/xlibre/refs/heads/main/LICENSE>LICENSE"
checksum="f751e1d173641da675dda69deb98ffa7e505fade0609d2c913dad4899e42d7f9"
skip_extraction="LICENSE"

do_install() {
	vmkdir usr/share/xbps.d

	case "$XBPS_TARGET_MACHINE" in
		aarch64)
			echo "repository=https://github.com/xlibre-void/xlibre-xserver/releases/download/repository-aarch64" > \
				${DESTDIR}/usr/share/xbps.d/99-repository-aarch64.conf
			;;
		aarch64-musl)
			echo "repository=https://github.com/xlibre-void/xlibre-xserver/releases/download/repository-aarch64-musl" > \
				${DESTDIR}/usr/share/xbps.d/99-repository-aarch64-musl.conf
			;;
		armv7l)
			echo "repository=https://github.com/xlibre-void/xlibre-xserver/releases/download/repository-armv7l" > \
				${DESTDIR}/usr/share/xbps.d/99-repository-armv7l.conf
			;;
		armv6l-musl)
			echo "repository=https://github.com/xlibre-void/xlibre-xserver/releases/download/repository-armv6l-musl" > \
				${DESTDIR}/usr/share/xbps.d/99-repository-armv6l-musl.conf
			;;
		*)
			msg_error "$pkgname: unsupported architecture $XBPS_TARGET_MACHINE\n"
			;;
	esac

	vlicense ${XBPS_SRCDISTDIR}/${pkgname}-${version}/LICENSE
}
